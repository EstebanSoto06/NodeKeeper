DATABASE_URL="postgresql://nodekeeper:your_password_here@localhost:5432/nodekeeper_dev?schema=public"
JWT_SECRET=generate_a_secret_here
PORT=4000
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads/evidences
MAX_FILE_SIZE_MB=10
MAX_EVIDENCES_PER_MAINTENANCE=20
SEED_ADMIN_PASSWORD=your_password_here
SEED_OPERATOR_PASSWORD=your_password_here

# Rate limiting general de la API (todas las rutas bajo /api, excepto /api/health)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Rate limiting estricto de POST /api/auth/login (solo intentos fallidos)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
